---
// A drawing of the real ScreenPulse answer window.
import Logo from "./Logo.astro";
const { answer = "Answer: B", status = "Answer · gemini-3.8-flash · 3.4 s" } = Astro.props;
---
<div class="aw" role="img" aria-label={`ScreenPulse answer window showing “${answer}”`}>
  <div class="aw-head">
    <span class="aw-icon"><Logo size={15} wordmark={false} /></span>
    <span>
      <b>ScreenPulse</b>
      <span class="aw-status"><i></i><span data-aw-status>{status}</span></span>
    </span>
  </div>
  <p class="aw-answer" data-aw-answer>{answer}</p>
  <div class="aw-foot"><span>Ask about the screenshot…</span><i></i></div>
</div>
<style>
  .aw { width: 232px; padding: 12px; border-radius: 13px; background: rgb(246 246 247 / 0.94); color: var(--ink);
    border: 1px solid rgb(0 0 0 / 0.14); box-shadow: 0 18px 40px rgb(0 0 0 / 0.28); font-size: 12px; line-height: 1.3; }
  .aw-head { display: flex; gap: 9px; align-items: center; padding-bottom: 10px; border-bottom: 1px solid rgb(0 0 0 / 0.1); }
  .aw-icon { display: grid; place-items: center; width: 28px; height: 28px; border-radius: 8px; background: rgb(19 20 23 / 0.08); }
  .aw-head b { display: block; font-weight: 600; }
  .aw-status { display: flex; align-items: center; gap: 5px; color: var(--muted); font-size: 10.5px; white-space: nowrap; }
  .aw-status i { width: 6px; height: 6px; border-radius: 50%; background: var(--led); }
  .aw-answer { font-size: 19px; font-weight: 600; letter-spacing: -0.02em; padding: 14px 4px; }
  .aw-foot { display: flex; justify-content: space-between; align-items: center; height: 30px; padding: 0 6px 0 12px; border-radius: 15px;
    background: rgb(19 20 23 / 0.06); border: 1px solid rgb(19 20 23 / 0.1); color: var(--muted); font-size: 11.5px; }
  .aw-foot i { width: 18px; height: 18px; border-radius: 50%; background: var(--ink); }
</style>
