---
// A screenshot slot. Drop public/setup/<name>.png and it appears; until then a clearly marked
// placeholder says what to capture. Missing screenshots are listed in the build output.
import { existsSync } from "node:fs";
import path from "node:path";
const { name, alt, capture } = Astro.props as { name: string; alt: string; capture: string };
const file = path.join(process.cwd(), "public", "setup", `${name}.png`);
const present = existsSync(file);
if (!present) console.warn(`[setup guide] screenshot missing: public/setup/${name}.png — ${capture}`);
---
<figure class:list={["shot", !present && "missing"]}>
  {present
    ? <img src={`/setup/${name}.png`} alt={alt} loading="lazy" />
    : <div class="ph" role="img" aria-label={`Screenshot to be added: ${alt}`}>
        <b>Screenshot to be added</b>
        <span>{alt}</span>
        <small>To capture: {capture}</small>
        <code>public/setup/{name}.png</code>
      </div>}
</figure>
<style>
  .shot img { width: 100%; height: auto; border-radius: var(--r-panel); border: 1px solid var(--alu-deep); box-shadow: 0 18px 36px -24px rgb(19 20 23 / 0.4); }
  .ph { display: grid; gap: 6px; justify-items: start; padding: 22px; border: 1px dashed #9ea2a9; border-radius: var(--r-panel); background: var(--plate); min-height: 150px; align-content: center; }
  .ph b { color: var(--ink); }
  .ph span, .ph small { color: var(--muted); }
  .ph code { font: 500 0.8125rem ui-monospace, "SF Mono", Menlo, monospace; color: var(--muted); }
</style>
